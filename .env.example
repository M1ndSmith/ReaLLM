# LiteLLM detects a provider when the matching *_API_KEY is set.
# Add any keys you have; the API lists that provider's models automatically.

GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
TOGETHERAI_API_KEY=
COHERE_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=

# Reliability (LiteLLM Router). Leave unset to use defaults.
LITELLM_NUM_RETRIES=2
LITELLM_CACHE=1
DEFAULT_RPM=60
GROQ_RPM=30
OPENAI_RPM=500
# REDIS_URL=redis://localhost:6379/0

