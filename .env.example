# Full control surface. For a short file, copy env/groq.env, env/ollama.env,
# env/memory.env, or env/full.env over .env instead.
# Empty *_API_KEY and Langfuse lines are ignored. Groq is not a lock-in.
# Startup is fail-closed unless GATEWAY_ALLOW_OPEN=1 (loopback only).
# MEMORY: MEMORY_LLM_MODEL may match your chat id; do not point Mem0 at POST /chat;
#   FastEmbed is local (Groq has no embeddings). Settings overlay can keep MEMORY on
#   after MEMORY=0 in this file.
# GUARD: master switch only. Two extra models (not the chat model). Groq is drop-in
#   (llama-prompt-guard-2-22m + llama-guard-4-12b). Other providers need exact
#   GET /models ids on GUARD_INJECTION_MODEL / GUARD_CONTENT_MODEL.
#
# LiteLLM detects a provider when the matching *_API_KEY is set.
# Add any keys you have; the API lists that provider's models automatically.

# Inbound auth for this process (not a provider *_API_KEY).
# Default is fail-closed: the process will not start without GATEWAY_API_KEY
# (or another issued key) unless GATEWAY_ALLOW_OPEN=1.
# Compose forces GATEWAY_ALLOW_OPEN=0 and binds 127.0.0.1:8000.
# Send Authorization: Bearer <key> or X-Api-Key.
# GATEWAY_API_KEY=
# GATEWAY_MULTI_KEY=1
# Required when GATEWAY_ALLOW_OPEN=0 (Compose). Hashes issued gateway keys.
# GATEWAY_KEY_PEPPER=
# Loopback-only opt-out for the documented 127.0.0.1 command. Do not keep this
# set on Compose or any bind reachable beyond this machine.
GATEWAY_ALLOW_OPEN=1

GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
TOGETHERAI_API_KEY=
COHERE_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=

# Local Ollama. Any non-empty dummy key turns the provider on. Ollama does not check it.
# Restart uvicorn after changing these. Pull a model first (`ollama pull llama3.2`).
# Docker Compose: use http://host.docker.internal:11434 (or the host IP), not localhost.
# Leave GUARD=0 unless those classifier ids appear in GET /models.
# OLLAMA_API_KEY=ollama
# OLLAMA_API_BASE=http://127.0.0.1:11434

# Reliability (LiteLLM Router). Leave unset to use defaults.
LITELLM_NUM_RETRIES=2
LITELLM_CACHE=1
LITELLM_CACHE_TTL=120
DEFAULT_RPM=60
GROQ_RPM=30
OPENAI_RPM=500
# Optional token-per-minute caps (Groq quotas are often token-shaped).
# GROQ_TPM=
# OPENAI_TPM=
# DEFAULT_TPM=
# Fallback allowlist (catalog ids). Unset = same-provider chat models.
# 0/off/none = retry only. Comma-separated ids = explicit allowlist.
# FALLBACKS=groq/openai/gpt-oss-20b,groq/openai/gpt-oss-120b
# Required past one uvicorn worker: shared response cache, RPM/TPM/cooldown, daily budget.
# On the host: redis://localhost:6379/0
# docker compose overrides this on the gateway service to redis://redis:6379/0
# REDIS_URL=redis://localhost:6379/0

# Optional Langfuse prompt management and tracing. Leave unset to use local prompts/*.json only.
# LANGFUSE_HOST is accepted as an alias for LANGFUSE_BASE_URL.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING=1
# Set LANGFUSE_TRACING=0 to keep prompt fetch without LiteLLM traces.

# Cost / token / budget. MAX_OUTPUT_TOKENS is always applied (default 2048).
# Leave the others empty to report usage without rejecting.
# Daily ledger is Redis when REDIS_URL is set, otherwise data/budget-state.json.
MAX_OUTPUT_TOKENS=2048
# MAX_INPUT_TOKENS=8000
# DAILY_TOKEN_BUDGET=200000
# DAILY_USD_BUDGET=1.00

# Optional Mem0 sidecar. Unset or 0 keeps chat stateless.
# MEMORY=1
# MEMORY_LLM_MODEL=
# MEMORY_EMBEDDER=fastembed

# Optional Presidio PII mask. Unset or 0 leaves chat and memory text unchanged.
# Also install the extra: pip install -r requirements-pii.txt
# PII=1
# PII_SPACY_MODEL=en_core_web_sm
# Default entities: EMAIL_ADDRESS, PHONE_NUMBER, CREDIT_CARD, US_SSN, IBAN_CODE, IP_ADDRESS.
# Add PERSON only if you accept NER false positives.
# PII_ENTITIES=EMAIL_ADDRESS,PHONE_NUMBER,CREDIT_CARD,US_SSN,IBAN_CODE,IP_ADDRESS

# Optional Prompt Guard 2 (injection) + Llama Guard 4 (content moderation) via the Router.
# Requires those models in GET /models. Missing ids → 503. Override with catalog ids.
# GUARD=1
# GUARD_INJECTION=1
# GUARD_CONTENT=1
# GUARD_INJECTION_MODEL=groq/meta-llama/llama-prompt-guard-2-22m
# GUARD_CONTENT_MODEL=groq/meta-llama/llama-guard-4-12b
# Comma-separated MLCommons codes to allow through Llama Guard (unset = block every S*).
# S6 = specialized advice; S7 overlaps Presidio when PII=1.
# GUARD_CONTENT_IGNORE=S6,S7

# Structured output is per-request on POST /chat (response_format), not an env flag.
# { "type": "json_object" } or { "type": "json_schema", "json_schema": { "name", "schema", "strict?" } }
# Omit the field for free-text chat. stream: true with response_format is 400.

# Next.js console on :3000 talks to this API directly (not proxied). Restart after changing keys or Redis.
# Layer flags MEMORY / PII / GUARD can also be flipped from the console Settings page when GATEWAY_API_KEY is set
# (writes data/runtime-flags.json; does not rewrite this file).
# REQUEST_ID=1
# STRUCTURED_LOGS=0
# OBS_METRICS=0
# READINESS_ALLOW_REDIS_DEGRADED=0
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CONSOLE_URL=http://localhost:3000
