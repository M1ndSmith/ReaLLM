# Keys and deployment wiring. Rate limits, memory, PII, guards, and budgets
# live in config/realmm.yaml (REALMM_CONFIG selects another file).
# Presets: cp env/groq.env, env/ollama.env, env/memory.env, or env/full.env
# over .env. Each one points REALMM_CONFIG at config/<preset>.yaml.
# Empty *_API_KEY and Langfuse lines are ignored. Groq is not a lock-in.
# Startup is fail-closed unless GATEWAY_ALLOW_OPEN=1 (loopback only).
# Settings overlay can keep MEMORY / PII / GUARD on after the policy file says off.
#
# LiteLLM detects a provider when the matching *_API_KEY is set.
# Add any keys you have; the API lists that provider's models automatically.

# Inbound auth for this process (not a provider *_API_KEY).
# Default is fail-closed: the process will not start without GATEWAY_API_KEY
# (or another issued key) unless GATEWAY_ALLOW_OPEN=1.
# Compose forces GATEWAY_ALLOW_OPEN=0 and binds 127.0.0.1:8000.
# Send Authorization: Bearer <key> or X-Api-Key.
# GATEWAY_API_KEY=
# GATEWAY_MULTI_KEY=1
# Required when GATEWAY_ALLOW_OPEN=0 (Compose). Hashes issued gateway keys.
# GATEWAY_KEY_PEPPER=
# Loopback-only opt-out for the documented 127.0.0.1 command. Do not keep this
# set on Compose or any bind reachable beyond this machine.
GATEWAY_ALLOW_OPEN=1

GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
TOGETHERAI_API_KEY=
COHERE_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=

# Local Ollama. Any non-empty dummy key turns the provider on. Ollama does not check it.
# Restart uvicorn after changing these. Pull a model first (`ollama pull llama3.2`).
# Docker Compose: use http://host.docker.internal:11434 (or the host IP), not localhost.
# OLLAMA_API_KEY=ollama
# OLLAMA_API_BASE=http://127.0.0.1:11434

# Required past one uvicorn worker: shared response cache, RPM/TPM/cooldown, daily budget.
# On the host: redis://localhost:6379/0
# docker compose overrides this on the gateway service to redis://redis:6379/0
# REDIS_URL=redis://localhost:6379/0

# Optional Langfuse prompt management and tracing. Leave unset to use local prompts/*.json only.
# LANGFUSE_HOST is accepted as an alias for LANGFUSE_BASE_URL.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING=1
# Set LANGFUSE_TRACING=0 to keep prompt fetch without LiteLLM traces.

# Structured output is per-request on POST /chat (response_format), not an env flag.
# { "type": "json_object" } or { "type": "json_schema", "json_schema": { "name", "schema", "strict?" } }
# Omit the field for free-text chat. stream: true with response_format is 400.

# Next.js console on :3000 talks to this API directly (not proxied). Restart after changing keys or Redis.
# Layer flags MEMORY / PII / GUARD can also be flipped from the console Settings page when GATEWAY_API_KEY is set
# (writes data/runtime-flags.json; does not rewrite config/realmm.yaml).
# REQUEST_ID=1
# STRUCTURED_LOGS=0
# OBS_METRICS=0
# READINESS_ALLOW_REDIS_DEGRADED=0
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CONSOLE_URL=http://localhost:3000
# REALMM_CONFIG=config/realmm.yaml
