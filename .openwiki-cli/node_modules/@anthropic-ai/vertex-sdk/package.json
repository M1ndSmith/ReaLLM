{
  "name": "@anthropic-ai/vertex-sdk",
  "version": "0.19.9",
  "description": "The official TypeScript library for the Anthropic Vertex API",
  "author": "Anthropic <support@anthropic.com>",
  "types": "./index.d.ts",
  "main": "./index.js",
  "type": "commonjs",
  "repository": "github:anthropics/anthropic-sdk-typescript",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/sdk": ">=0.115.1 <1",
    "google-auth-library": "^10.2.0"
  },
  "imports": {
    "@anthropic-ai/vertex-sdk": ".",
    "@anthropic-ai/vertex-sdk/*": "./src/*"
  },
  "exports": {
    ".": {
      "require": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./client": {
      "import": "./client.mjs",
      "require": "./client.js"
    },
    "./client.js": {
      "default": "./client.js"
    },
    "./client.mjs": {
      "default": "./client.mjs"
    },
    "./core/*.mjs": {
      "default": "./core/*.mjs"
    },
    "./core/*.js": {
      "default": "./core/*.js"
    },
    "./core/*": {
      "import": "./core/*.mjs",
      "require": "./core/*.js"
    },
    "./index": {
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./index.js": {
      "default": "./index.js"
    },
    "./index.mjs": {
      "default": "./index.mjs"
    },
    "./tools/agent-toolset/node": {
      "browser": {
        "import": "./tools/agent-toolset/node.browser.mjs",
        "require": "./tools/agent-toolset/node.browser.js"
      },
      "import": "./tools/agent-toolset/node.mjs",
      "require": "./tools/agent-toolset/node.js"
    },
    "./tools/memory/node": {
      "browser": {
        "import": "./tools/memory/node.browser.mjs",
        "require": "./tools/memory/node.browser.js"
      },
      "import": "./tools/memory/node.mjs",
      "require": "./tools/memory/node.js"
    }
  },
  "scripts": {
    "test": "jest",
    "build": "bash ./build",
    "format": "prettier --write --cache --cache-strategy metadata . !dist",
    "lint": "eslint --ext ts,js .",
    "fix": "eslint --fix --ext ts,js ."
  }
}