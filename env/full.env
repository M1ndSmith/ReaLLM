# Groq chat + Mem0 + Prompt Guard 2 + Llama Guard 4.
# cp env/full.env .env && fill GROQ_API_KEY && restart uvicorn
# All four model ids must appear in GET /models or chat returns 503.
# Compose: set GATEWAY_API_KEY and GATEWAY_KEY_PEPPER (Compose forces GATEWAY_ALLOW_OPEN=0).

GROQ_API_KEY=
GATEWAY_ALLOW_OPEN=1
MEMORY=1
MEMORY_LLM_MODEL=groq/llama-3.1-8b-instant
MEMORY_EMBEDDER=fastembed
PII=0
GUARD=1
GUARD_INJECTION=1
GUARD_CONTENT=1
GUARD_INJECTION_MODEL=groq/meta-llama/llama-prompt-guard-2-22m
GUARD_CONTENT_MODEL=groq/meta-llama/llama-guard-4-12b
