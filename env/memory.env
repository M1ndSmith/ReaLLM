# Groq chat + Mem0. No guard.
# cp env/memory.env .env && fill GROQ_API_KEY && restart uvicorn
# Extract uses MEMORY_LLM_MODEL (must be in GET /models; avoid reasoning ids).
# Embedder is local FastEmbed (Groq has no embeddings API). First request downloads ONNX.
# Compose: set GATEWAY_API_KEY and GATEWAY_KEY_PEPPER (Compose forces GATEWAY_ALLOW_OPEN=0).

GROQ_API_KEY=
GATEWAY_ALLOW_OPEN=1
MEMORY=1
MEMORY_LLM_MODEL=groq/llama-3.1-8b-instant
MEMORY_EMBEDDER=fastembed
PII=0
GUARD=0
