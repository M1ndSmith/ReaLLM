# NVIDIA NIM chat + Mem0 embeddings + Nemotron Content Safety.
# Policy: config/nvidia.yaml
# cp env/nvidia.env .env && fill NVIDIA_NIM_API_KEY && restart uvicorn
# The key from build.nvidia.com is the same value. LiteLLM reads NVIDIA_NIM_API_KEY.
# Use a fresh data/ memory directory. A FastEmbed collection is 384-d; this embedder is 2048-d.
# Compose: set GATEWAY_API_KEY and GATEWAY_KEY_PEPPER (Compose forces GATEWAY_ALLOW_OPEN=0).

NVIDIA_NIM_API_KEY=
NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1
GATEWAY_ALLOW_OPEN=1
REALMM_CONFIG=config/nvidia.yaml
