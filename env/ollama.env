# Ollama chat only. No memory, no guard.
# cp env/ollama.env .env && ollama pull llama3.2 && restart uvicorn
# Compose: set GATEWAY_API_KEY and GATEWAY_KEY_PEPPER (Compose forces GATEWAY_ALLOW_OPEN=0).
# Compose BASE: http://host.docker.internal:11434

OLLAMA_API_KEY=ollama
OLLAMA_API_BASE=http://127.0.0.1:11434
GATEWAY_ALLOW_OPEN=1
MEMORY=0
PII=0
GUARD=0
