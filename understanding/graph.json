{
  "meta": {
    "name": "ReaLMM",
    "package": "realmm",
    "version": "0.1.0",
    "evidence": "Python, TypeScript, YAML, JSON, and workflow YAML only. No markdown was read.",
    "node_kinds": ["module", "symbol", "route", "port", "adapter", "store", "external", "config", "test", "ui"],
    "edge_kinds": ["imports", "implements", "calls", "authenticates", "persists", "configures", "tested_by", "serves"]
  },
  "nodes": [
    {"id": "mod.main", "kind": "module", "path": "app/main.py", "role": "ASGI export: app = create_configured_app()."},
    {"id": "sym.create_configured_app", "kind": "symbol", "path": "app/bootstrap.py", "role": "Loads .env once, builds GatewaySettings and GatewayRuntime, returns create_app(runtime)."},
    {"id": "sym.build_runtime", "kind": "symbol", "path": "app/bootstrap.py", "role": "Composition root that constructs adapters and ChatService."},
    {"id": "sym.GatewayRuntime", "kind": "symbol", "path": "app/container.py", "role": "Process handle: settings, adapters, chat. start() enforces auth/pepper and refreshes catalog; close() drains memory and closes budget and router."},
    {"id": "sym.GatewaySettings", "kind": "symbol", "path": "app/settings.py", "role": "Static knobs. Provider API keys stay in os.environ for LiteLLM."},
    {"id": "sym.PolicyYamlSource", "kind": "symbol", "path": "app/settings.py", "role": "Flattens REALMM_CONFIG YAML onto settings fields, below env and dotenv sources."},
    {"id": "sym.create_app", "kind": "symbol", "path": "app/api/app.py", "role": "FastAPI app titled ReaLMM. Open root router plus an authenticated API router."},
    {"id": "sym.require_gateway_auth", "kind": "symbol", "path": "app/api/auth.py", "role": "Bearer or X-Api-Key. Multi-key store when auth is on; else optional legacy GATEWAY_API_KEY HMAC compare."},
    {"id": "sym.require_scopes", "kind": "symbol", "path": "app/api/dependencies.py", "role": "OR of named scopes. Missing identity is 401 when auth is on, otherwise skipped. Empty intersection is 403."},
    {"id": "sym.ChatService", "kind": "symbol", "path": "app/application/chat.py", "role": "complete() and stream() orchestration over ports."},
    {"id": "sym.ChatCommand", "kind": "symbol", "path": "app/application/models.py", "role": "Pipeline input including identity_id, prompt selectors, tools, and response_format."},
    {"id": "sym.RuntimeFlags", "kind": "symbol", "path": "app/application/models.py", "role": "memory, pii, guard, guard_injection, guard_content."},
    {"id": "sym.IdentityScope", "kind": "symbol", "path": "app/application/models.py", "role": "Literal scopes: read, chat, config, admin."},

    {"id": "port.CompletionBackend", "kind": "port", "path": "app/application/ports.py", "role": "acompletion, completion, chat_fallback_ids, reliability_status."},
    {"id": "port.ModelCatalogPort", "kind": "port", "path": "app/application/ports.py", "role": "Detected providers, model list, resolve_model, fallback_from."},
    {"id": "port.PromptPort", "kind": "port", "path": "app/application/ports.py", "role": "prepare_messages, prompt catalog, tracing hook."},
    {"id": "port.MemoryPort", "kind": "port", "path": "app/application/ports.py", "role": "attach search results and schedule_record."},
    {"id": "port.PiiPort", "kind": "port", "path": "app/application/ports.py", "role": "redact_messages and redact_text."},
    {"id": "port.GuardPort", "kind": "port", "path": "app/application/ports.py", "role": "assert_inbound and assert_outbound."},
    {"id": "port.UsageBudgetPort", "kind": "port", "path": "app/application/ports.py", "role": "token_count, assert_rpm, reserve, record_usage, release."},
    {"id": "port.IdentityQuotaPort", "kind": "port", "path": "app/application/ports.py", "role": "quotas_for(identity_id)."},
    {"id": "port.FlagStorePort", "kind": "port", "path": "app/application/ports.py", "role": "snapshot() of RuntimeFlags."},
    {"id": "port.StageClock", "kind": "port", "path": "app/application/ports.py", "role": "stage() timings: preflight, provider, postprocess."},

    {"id": "adp.LiteLLMRouterRuntime", "kind": "adapter", "path": "app/infrastructure/router.py", "role": "Sole owner of litellm.Router and cache mutation."},
    {"id": "adp.ProviderCatalog", "kind": "adapter", "path": "app/infrastructure/catalog.py", "role": "Providers inferred from env API keys, plus ollama when its key is set. NVIDIA_API_KEY aliases to NVIDIA_NIM_API_KEY."},
    {"id": "adp.PromptRepository", "kind": "adapter", "path": "app/infrastructure/prompts.py", "role": "Local prompts JSON and optional Langfuse prompts plus tracing callback."},
    {"id": "adp.MemoryRuntime", "kind": "adapter", "path": "app/infrastructure/memory.py", "role": "Mem0 with on-disk Qdrant. Embedder default fastembed; openai and NVIDIA Nemotron embed ids are built in."},
    {"id": "adp.PiiRuntime", "kind": "adapter", "path": "app/infrastructure/pii.py", "role": "Presidio analyzer and anonymizer."},
    {"id": "adp.GuardService", "kind": "adapter", "path": "app/infrastructure/guards.py", "role": "Injection and content scans through the router, including Nemotron verdict parsers."},
    {"id": "adp.BudgetRuntime", "kind": "adapter", "path": "app/infrastructure/budget.py", "role": "Daily token and USD caps, reservations, identity RPM. Redis ledger or data/budget-state.json."},
    {"id": "adp.GatewayIdentityStore", "kind": "adapter", "path": "app/infrastructure/identities.py", "role": "Hashed gateway keys, scopes, and per-key quotas."},
    {"id": "adp.RuntimeFlagStore", "kind": "adapter", "path": "app/infrastructure/flags.py", "role": "Overlays five layer flags from data/runtime-flags.json without mutating os.environ."},
    {"id": "adp.StageTelemetry", "kind": "adapter", "path": "app/infrastructure/telemetry.py", "role": "StageClock used by ChatService."},
    {"id": "adp.RedisHealth", "kind": "adapter", "path": "app/infrastructure/redis_health.py", "role": "Configured, reachable, and mode for cache, budget, and readiness."},
    {"id": "adp.MetricsRuntime", "kind": "adapter", "path": "app/infrastructure/metrics.py", "role": "Prometheus text when OBS_METRICS is on; otherwise /metrics is 404."},

    {"id": "route.root", "kind": "route", "path": "app/api/routes/root.py", "role": "GET / HTML pointer to the console. Unauthenticated."},
    {"id": "route.healthz", "kind": "route", "path": "app/api/routes/root.py", "role": "GET /healthz liveness. Unauthenticated."},
    {"id": "route.health", "kind": "route", "path": "app/api/routes/meta.py", "role": "GET /health. Scope read."},
    {"id": "route.providers", "kind": "route", "path": "app/api/routes/meta.py", "role": "GET /providers. Scope read."},
    {"id": "route.models", "kind": "route", "path": "app/api/routes/meta.py", "role": "GET /models. Scope read."},
    {"id": "route.prompts", "kind": "route", "path": "app/api/routes/meta.py", "role": "GET /prompts. Scope read."},
    {"id": "route.budget", "kind": "route", "path": "app/api/routes/meta.py", "role": "GET /budget. Scope read."},
    {"id": "route.ready", "kind": "route", "path": "app/api/routes/ready.py", "role": "GET /ready. Scope read. 503 unless providers exist and Redis is ok or degraded-allowed."},
    {"id": "route.metrics", "kind": "route", "path": "app/api/routes/metrics.py", "role": "GET /metrics. Scope read. 404 when metrics are disabled."},
    {"id": "route.config_get", "kind": "route", "path": "app/api/routes/config.py", "role": "GET /config. Gateway auth only; no extra scope."},
    {"id": "route.config_patch", "kind": "route", "path": "app/api/routes/config.py", "role": "PATCH /config. Scope config, and a configured gateway key."},
    {"id": "route.memory_search", "kind": "route", "path": "app/api/routes/memory.py", "role": "GET /memory. Scope read or chat."},
    {"id": "route.memory_add", "kind": "route", "path": "app/api/routes/memory.py", "role": "POST /memory. Scope chat."},
    {"id": "route.memory_delete", "kind": "route", "path": "app/api/routes/memory.py", "role": "DELETE /memory/{memory_id}. Scope chat."},
    {"id": "route.chat", "kind": "route", "path": "app/api/routes/chat.py", "role": "POST /chat JSON or native SSE. Scope chat."},
    {"id": "route.v1_models", "kind": "route", "path": "app/api/routes/openai.py", "role": "GET /v1/models. Scope read or chat."},
    {"id": "route.v1_chat", "kind": "route", "path": "app/api/routes/openai.py", "role": "POST /v1/chat/completions. Scope chat."},
    {"id": "route.v1_embeddings", "kind": "route", "path": "app/api/routes/openai.py", "role": "POST /v1/embeddings. Scope chat. Budget and identity RPM apply."},
    {"id": "route.admin_keys", "kind": "route", "path": "app/api/routes/admin.py", "role": "GET/POST /admin/keys, PATCH/DELETE /admin/keys/{key_id}. Scope admin."},

    {"id": "sym.classify", "kind": "symbol", "path": "app/api/errors.py", "role": "Maps domain and LiteLLM errors to HTTP statuses."},
    {"id": "sym.encode_native", "kind": "symbol", "path": "app/api/encoders/native.py", "role": "Stream events to native SSE frames."},
    {"id": "sym.encode_openai", "kind": "symbol", "path": "app/api/encoders/openai.py", "role": "Stream events to OpenAI chat chunks plus sidecar fields."},

    {"id": "store.runtime_flags", "kind": "store", "path": "data/runtime-flags.json", "role": "Layer overlay written by PATCH /config."},
    {"id": "store.gateway_keys", "kind": "store", "path": "data/gateway-keys.json", "role": "Issued key hashes, scopes, quotas."},
    {"id": "store.budget_state", "kind": "store", "path": "data/budget-state.json", "role": "File ledger when Redis is unused or unreachable."},
    {"id": "store.mem0", "kind": "store", "path": "data/mem0", "role": "Mem0 directory; Qdrant path is data/mem0/qdrant."},
    {"id": "store.prompts", "kind": "store", "path": "prompts", "role": "Local prompt JSON. chat-assistant.json is the shipped prompt."},

    {"id": "ext.litellm", "kind": "external", "path": "app/infrastructure/router.py", "role": "Provider completions, embeddings, retries, cooldown, response cache."},
    {"id": "ext.redis", "kind": "external", "path": "compose.yaml", "role": "Shared cache, RPM/TPM/cooldown, daily budget. Compose service redis:7-alpine."},
    {"id": "ext.mem0", "kind": "external", "path": "app/infrastructure/memory.py", "role": "Memory extract and search."},
    {"id": "ext.qdrant", "kind": "external", "path": "app/infrastructure/memory.py", "role": "On-disk vector store provider for Mem0."},
    {"id": "ext.presidio", "kind": "external", "path": "app/infrastructure/pii.py", "role": "PII detection and anonymization. spaCy is an optional extra."},
    {"id": "ext.langfuse", "kind": "external", "path": "app/infrastructure/prompts.py", "role": "Remote prompts and optional tracing."},
    {"id": "ext.providers", "kind": "external", "path": "app/infrastructure/catalog.py", "role": "Provider HTTP APIs. Compat bases in catalog include groq, openai, deepseek, xai, mistral, openrouter, together_ai, cerebras, fireworks_ai, nvidia_nim, ollama."},

    {"id": "cfg.realmm", "kind": "config", "path": "config/realmm.yaml", "role": "Default policy: rate_limits, reliability, memory, pii, guards, budget."},
    {"id": "cfg.presets", "kind": "config", "path": "config", "role": "groq.yaml and ollama.yaml are layer flags. memory.yaml and full.yaml add memory and guard knobs. nvidia.yaml adds rate, reliability, and budget."},
    {"id": "cfg.compose", "kind": "config", "path": "compose.yaml", "role": "redis, gateway on 127.0.0.1:8000, web on 127.0.0.1:3000. Forces GATEWAY_ALLOW_OPEN=0 and one worker."},
    {"id": "cfg.ci", "kind": "config", "path": ".github/workflows/ci.yml", "role": "Gitleaks, Python 3.12-3.14 with Redis, web typecheck coverage and build."},

    {"id": "ui.console", "kind": "ui", "path": "web/components/ConsoleShell.tsx", "role": "Shared shell for play, connect, and settings views."},
    {"id": "ui.page_play", "kind": "ui", "path": "web/app/page.tsx", "role": "Route / renders Console view=play."},
    {"id": "ui.page_connect", "kind": "ui", "path": "web/app/connect/page.tsx", "role": "Route /connect."},
    {"id": "ui.page_settings", "kind": "ui", "path": "web/app/settings/page.tsx", "role": "Route /settings."},
    {"id": "ui.healthz", "kind": "ui", "path": "web/app/healthz/route.ts", "role": "Next liveness JSON. Separate from the Python /healthz."},
    {"id": "ui.useChatSession", "kind": "ui", "path": "web/hooks/useChatSession.ts", "role": "Transcript and streaming send. Session key realmm.conversation_id."},
    {"id": "ui.useGatewayCatalog", "kind": "ui", "path": "web/hooks/useGatewayCatalog.ts", "role": "Parallel GET /health, /models, /prompts, /ready. Session key realmm.model."},
    {"id": "ui.useGatewayKey", "kind": "ui", "path": "web/hooks/useGatewayKey.ts", "role": "sessionStorage key realmm.gateway_key via lib/auth."},
    {"id": "ui.useRuntimeConfig", "kind": "ui", "path": "web/hooks/useRuntimeConfig.ts", "role": "GET and PATCH /config layer toggles."},
    {"id": "ui.useOperatorState", "kind": "ui", "path": "web/hooks/useOperatorState.ts", "role": "Derives open, needs_key, or authorized and blocked actions."},
    {"id": "ui.streamChat", "kind": "ui", "path": "web/lib/chatClient.ts", "role": "POST /chat with stream true. Parses SSE."},
    {"id": "ui.gateway", "kind": "ui", "path": "web/lib/gateway.ts", "role": "Base URL from NEXT_PUBLIC_GATEWAY_URL or http://127.0.0.1:8000. Bearer JSON fetch."},

    {"id": "test.architecture", "kind": "test", "path": "tests/test_architecture.py", "role": "Application layer does not import FastAPI, LiteLLM, Mem0, Presidio, Redis, API, or infrastructure. Only the router runtime owns Router(."},
    {"id": "test.pipeline", "kind": "test", "path": "tests/test_pipeline.py", "role": "Locks complete() call order and stream event order."},
    {"id": "test.settings", "kind": "test", "path": "tests/test_settings.py", "role": "Env wins over dotenv and YAML."}
  ],
